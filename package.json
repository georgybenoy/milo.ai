{
  "name": "milo",
  "version": "1.0.0",
  "description": "Milo — Your orders, answered.",
  "private": true,
  "scripts": {
    "install:frontend": "npm install --prefix frontend",
    "install-all": "npm install && npm run install:frontend",
    "dev": "concurrently -n backend,frontend -c green,cyan \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "uvicorn app.main:app --reload --port 8000 --app-dir backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:frontend",
    "test": "pytest backend/tests -v",
    "start": "uvicorn app.main:app --host 0.0.0.0 --port 8000 --app-dir backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
